# Copy to .env and fill in. .env is gitignored.
#
# ---- Backend credentials ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# LM Studio's OpenAI-compatible endpoint — point this at wherever LM Studio runs.
#   Same host as the harness:   http://127.0.0.1:1234/v1
#   A box on your LAN (the reference setup for the runs for record — e.g. an
#   RTX 4090 workstation): enable "Serve on Local Network" in LM Studio (binds
#   0.0.0.0), open the port in that host's firewall, then use its IP, e.g.
#   http://192.168.1.50:1234/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# ---- Run harness ----
# Backstop against runaway loops.
RUN_TOKEN_CAP=200000
# Hard cap on wall-clock seconds per run.
RUN_WALL_CLOCK_CAP_SECONDS=1800
# Where to write run records. Override for shared storage in cloud runs.
RUN_OUTPUT_DIR=./runs

# ---- Validator ----
# Container image used for sandboxed payload execution. Built by `make
# sandbox-build` as `sara-sandbox:latest`; pin by digest in prod
# (VALIDATOR_IMAGE=sara-sandbox@sha256:...). Must match the built image name.
VALIDATOR_IMAGE=sara-sandbox:latest

# ---- Logging ----
LOG_LEVEL=INFO
