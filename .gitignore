# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Environment ---
.env
.env.*
!.env.example

# --- Experimental data (NEVER COMMIT) ---
runs/
corpus/binaries/*
!corpus/binaries/.gitkeep
# The active run config(s) (may hold an in-progress matrix / edited caps); the
# committed template experiments.example.yaml stays tracked. The glob also covers
# the split run-for-record configs (experiments.premium.yaml / experiments.local.yaml).
experiments.yaml
experiments.*.yaml
!experiments.example.yaml

# --- Ghidra project artifacts ---
# PyGhidra writes a <binary>_ghidra.{gpr,rep} project next to the analysed
# binary during the `requires_ghidra` integration tests; never commit it.
*.gpr
*.rep/
*.lock
*_ghidra/

# --- Hypothesis ---
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/
# The notebooks under analysis/notebooks/*.ipynb are committed deliverables
# (Step 6); only their executed copies and generated figures are build output.
analysis/figures/

# --- Terraform ---
infra/terraform/.terraform/
infra/terraform/*.tfstate*
infra/terraform/.terraform.lock.hcl
# Account-specific vars (researcher IP, key name, …); keep only the example.
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# --- Packer ---
infra/packer/packer_cache/
infra/packer/*.box
