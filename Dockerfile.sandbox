#
# Research instrument for a SANS.edu thesis on LLM agents that build ROP
# exploit chains. The ethical scope in README.md is non-negotiable and binds
# all copies, forks, and derived works: educational/CTF targets only,
# proof-of-concept payloads only. Use against systems you do not own or are
# not authorized to test is prohibited.

# Validator sandbox image.
#
# This container executes candidate ROP payloads against corpus binaries.
# It is deliberately minimal: no network, no host mounts, no root.
#
# The sandbox is destroyed after every run. Any state must be written to the
# mounted output volume by the entrypoint.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 26.04 ships Python 3.14 in the default repositories. Pin apt
# versions in a follow-up commit once the toolchain is settled.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb \
        python3.14 \
        python3-pip \
        libc6-dev \
        libc6-i386 \
        gcc-multilib \
    && rm -rf /var/lib/apt/lists/*

# Python deps for exploit-script execution inside the sandbox.
# Under ADR 0016 the agent's exploit.py runs *inside* this one sandbox (the
# validator's single execution point), so the exploitation toolkit lives here:
# pwntools for ELF()/ROP()/packing/cyclic, pyelftools underneath. (Before Trial 2
# only pyelftools was installed, on the old assumption that construction happened
# outside the sandbox — ADR 0016 supersedes that.) pwntools runs offline: the
# sandbox has no network, and PWNLIB_NOTERM/PWNLIB_SILENT + HOME/XDG_CACHE_HOME
# on /tmp (set by the runner) keep it from touching the read-only rootfs.
#
# Installed system-wide (as root, before dropping to the sandbox user) rather than
# per-user: the runner overrides HOME to /tmp at run time (for pwntools' writable
# cache on the read-only rootfs), which would move Python's --user site-packages to
# an empty /tmp/.local and hide a per-user install (ModuleNotFoundError: pwn). A
# global install is on sys.path regardless of HOME, so the package location and
# pwntools' runtime cache dir are decoupled.
#
# unicorn is pinned to 2.1.1 deliberately. pwntools 4.15.0 requires
# `unicorn!=2.1.3,!=2.1.4,>=2.0.1`, whose highest match (2.1.2) publishes NO wheel,
# so pip builds it from the vendored-QEMU sdist — which fails to compile on this
# toolchain (Ubuntu 26.04 / GCC 14+ treats the implicit mprotect/PROT_* uses as hard
# errors). 2.1.1 ships a `py2.py3-none-manylinux` wheel that installs on Python 3.14
# with no compiler, so the image builds reproducibly and needs no build tooling.
# unicorn only backs pwntools' CPU emulation; ROP/ELF/packing/cyclic do not use it,
# so the pin has no effect on exploit construction or scoring.
RUN pip install --break-system-packages --no-cache-dir \
        pyelftools==0.32 \
        unicorn==2.1.1 \
        pwntools==4.15.0

# Non-root execution
RUN useradd --create-home --shell /bin/bash --uid 1500 sandbox
USER sandbox
WORKDIR /home/sandbox

# Hard timeout wrapper. The harness also enforces a timeout, but defence in depth.
ENTRYPOINT ["/usr/bin/timeout", "--kill-after=5", "30"]
CMD ["/bin/bash", "-c", "echo 'Pass --binary and --payload to the runner.'"]
