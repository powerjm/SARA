#
# Research instrument for a SANS.edu thesis on LLM agents that build ROP
# exploit chains. The ethical scope in README.md is non-negotiable and binds
# all copies, forks, and derived works: educational/CTF targets only,
# proof-of-concept payloads only. Use against systems you do not own or are
# not authorized to test is prohibited.

# Exploit-development / analysis workbench — the "hackbox".
#
# This is the deliberate OPPOSITE of Dockerfile.sandbox. Where the validator
# sandbox is minimal, network-less, read-only and non-root so it can *execute*
# candidate payloads safely, this image is a fully-tooled reverse-engineering
# and PoC-authoring bench: radare2, gdb+GEF, pwntools, ROPgadget, ropper (via
# the repo's vendored py3.14 filebytes wheel, ADR 0008), angr, the 32-bit
# toolchain, network, and sudo (plus best-effort keystone/one_gadget). It exists
# so a researcher (human or agent) can *develop* a working ROP chain against a
# corpus binary and write it up as corpus/exploits/<id>.py.
#
# ── Ethical / architectural scope ──────────────────────────────────────────
# Targets are the intentionally-vulnerable, MIT-licensed DARPA CGC binaries in
# corpus/manifest.yaml (educational/CTF only, per README.md). This image is a
# DEV tool and is NOT part of the experiment's scoring path:
#
#   * ADR 0002 stands — the validator sandbox (Dockerfile.sandbox) remains the
#     ONLY component that executes payloads *for record*. Nothing produced here
#     is a run outcome; it is authoring scaffolding, like a scratch REPL.
#   * A PoC written here becomes corpus/exploits/<id>.py, which is then gated by
#     the real validator via corpus/scripts/verify.py (`sara verify`). The
#     hackbox proves a chain to a human; the sandbox proves it for the thesis.
#
# ── What is NOT baked in ────────────────────────────────────────────────────
# The corpus binaries are gitignored (licensing + leakage hygiene) and are never
# COPYed into this image. Bind-mount the repo at build/run time instead:
#
#   docker build -f Dockerfile.hackbox -t sara-hackbox:latest \
#       --build-arg HOST_UID=$(id -u) --build-arg HOST_GID=$(id -g) .
#
#   docker run --rm -it \
#       --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
#       -v "$PWD":/sara -w /sara sara-hackbox:latest
#
# (SYS_PTRACE + unconfined seccomp let gdb/strace/ltrace attach; ASLR is off in
# gdb by default and `setarch -R <cmd>` disables it for a bare run. See
# scripts/hackbox.sh and `make hackbox` for the wrapped, correct invocation.)

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1

# ── System + analysis packages ─────────────────────────────────────────────
# The corpus binaries are i386 statically-linked ELFs, so we need the 32-bit
# toolchain/runtime (gcc-multilib, libc6-i386) to build helpers and to run/debug
# them on an x86_64 kernel (host needs IA32 emulation, which the lab host has).
RUN apt-get update && apt-get install -y --no-install-recommends \
        # -- build + 32-bit runtime/debug --
        build-essential \
        cmake \
        pkg-config \
        gcc-multilib \
        g++-multilib \
        libc6-dev \
        libc6-dev-i386 \
        libc6-i386 \
        # -- Python 3.14 (matches the project target) --
        python3.14 \
        python3.14-venv \
        python3.14-dev \
        python3-pip \
        # -- debuggers / tracers --
        gdb \
        gdbserver \
        ltrace \
        strace \
        # -- static analysis / RE --
        radare2 \
        binutils \
        elfutils \
        patchelf \
        file \
        xxd \
        # -- one_gadget toolchain --
        ruby \
        ruby-dev \
        # -- I/O plumbing for interactive targets --
        socat \
        netcat-openbsd \
        # -- dev quality-of-life --
        git \
        curl \
        wget \
        ca-certificates \
        sudo \
        vim \
        less \
        tmux \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# ── Python exploit toolkit — CORE (isolated venv on PATH) ───────────────────
# A venv keeps the toolkit off the PEP 668 "externally-managed" system Python
# while staying globally importable. pwntools pulls capstone/unicorn/pyelftools
# transitively; ROPgadget is added explicitly. Hard requirement — the build
# fails if any of these do not install.
ENV VIRTUAL_ENV=/opt/hackbox-venv
RUN python3.14 -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip wheel setuptools \
    && pip install --no-cache-dir \
        pwntools \
        ROPGadget \
        pyelftools \
        capstone \
        unicorn

# ── ropper via the repo's vendored, py3.14-patched filebytes wheel (ADR 0008) ─
# ropper needs `filebytes`, but no released filebytes builds on Python 3.14 —
# its setup.py uses the removed `ast.Str`/`.s`. The repo vendors a one-line-
# patched wheel; installing it FIRST pre-satisfies ropper's `filebytes>=0.10.0`
# so pip never tries to build the broken sdist. This is the exact pattern in
# infra/packer/provision/install-tools.sh, so ropper is a reliable tool here,
# not a best-effort skip. (Only the wheel is COPYed — keeps the layer cacheable.)
COPY vendor/filebytes/filebytes-0.10.2-py3-none-any.whl /tmp/filebytes/
RUN pip install --no-cache-dir /tmp/filebytes/filebytes-0.10.2-py3-none-any.whl \
    && pip install --no-cache-dir ropper \
    && rm -rf /tmp/filebytes

# ── Best-effort extras (must NOT fail the image) ────────────────────────────
# These lag a just-released CPython (the project targets 3.14), so each is its
# own layer with a `|| echo` guard — one failing must not block the other or the
# build. Same best-effort pattern as corpus/scripts/cb-multios/Dockerfile.
#
#   angr — symbolic execution: the right tool for the tier-2/3 OOB targets
#     (cromu-00002 collision-escape, kprca-00091 emulator) that need path/
#     constraint reasoning to reach the overwrite.
#   keystone-engine — assembler, the complement to capstone's disassembler.
RUN pip install --no-cache-dir angr \
        || echo "warning: angr failed to install (continuing)"
RUN pip install --no-cache-dir keystone-engine \
        || echo "warning: keystone-engine failed to install (continuing)"

# one_gadget: fast "single gadget that execve('/bin/sh')" finder. Best-effort.
RUN gem install --no-document one_gadget \
        || echo "warning: one_gadget gem failed to install (continuing)"

# ── GEF: gdb exploit-dev UI (rop, pattern, checksec, vmmap, …) ──────────────
# Single-file plugin fetched at build (network is available then). Sourced from
# a system-wide gdbinit so it is active for every user. Best-effort.
RUN mkdir -p /etc/gdb \
    && curl -fsSL https://raw.githubusercontent.com/hugsy/gef/main/gef.py \
        -o /opt/gef.py \
    && printf 'source /opt/gef.py\n' > /etc/gdb/gdbinit \
    || echo "warning: GEF download failed; plain gdb still available (continuing)"

# ── Non-root user with sudo, matched to the host uid/gid ────────────────────
# HOST_UID/HOST_GID default to 1000 but should be passed at build so files
# written to the bind-mounted repo are owned by the host user, not root.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN groupadd --gid "$HOST_GID" hacker 2>/dev/null || true \
    && useradd --uid "$HOST_UID" --gid "$HOST_GID" \
        --create-home --shell /bin/bash hacker 2>/dev/null \
        || usermod --login hacker --home /home/hacker --move-home \
            "$(getent passwd "$HOST_UID" | cut -d: -f1)" 2>/dev/null || true \
    && echo 'hacker ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/hacker \
    && chmod 0440 /etc/sudoers.d/hacker

# A short MOTD lists the tools + PoC recipes on interactive login. PWNLIB_NOTERM
# keeps pwntools' output stable when a PoC is run non-interactively (no tty).
COPY --chmod=0644 scripts/hackbox-motd.sh /etc/profile.d/hackbox-motd.sh
ENV PWNLIB_NOTERM=1

USER hacker
WORKDIR /sara
ENV HOME=/home/hacker

# Every corpus target is i386/linux, so make that pwntools' default context
# (read from ~/.config/pwn.conf) — snippets need no explicit context.update().
# Values are Python-literal strings: pwntools evaluates them via safeeval, which
# rejects the bare name `i386` (LOAD_NAME), so they must be quoted.
RUN mkdir -p /home/hacker/.config \
    && printf "[context]\narch='i386'\nos='linux'\n" > /home/hacker/.config/pwn.conf

# Interactive login shell (loads /etc/profile.d MOTD). No timeout wrapper — this
# is a workbench, not the timed validator sandbox.
ENTRYPOINT ["/bin/bash"]
CMD ["-l"]
